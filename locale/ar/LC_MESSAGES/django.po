#: .\myapp\templates\myapp\about.html:9 .\myapp\templates\myapp\base.html:44
msgid "درباره ما"
msgstr "من نحن"

#: .\myapp\templates\myapp\about.html:10
msgid "آشنایی با شرکت فرآورده‌های لبنی رامیار"
msgstr "التعريف بشركة راميار لمنتجات الألبان"

#: .\myapp\templates\myapp\base.html:42
msgid "خانه"
msgstr "الرئيسية"

#: .\myapp\templates\myapp\base.html:43
msgid "گالری"
msgstr "معرض الصور"

msgid "تماس با ما"
msgstr "اتصل بنا"

msgid "داستان ما"
msgstr "قصتنا"

msgid "تجربه‌ای از کیفیت و اصالت"
msgstr "تجربة من الجودة والأصالة"

msgid "شرکت فرآورده‌های لبنی رامیار تمیشه در سال ۱۳۸۹ تاسیس گشته و از آن زمان تاکنون با تکیه بر استانداردهای بین‌المللی، محصولات لبنی باکیفیت تولید می‌کند."
msgstr "تأسست شركة راميار تميشه للمنتجات اللبنية عام 1389 هـ.ش، ومنذ ذلك الحين وهي تنتج منتجات ألبان عالية الجودة وفقًا للمعايير الدولية."

msgid "این شرکت محصولات لبنی همچون روغن حیوانی و کره را به کشورهای عربی مانند عراق صادر می‌کند و در بازارهای داخلی و بین‌المللی جایگاه ویژه‌ای دارد."
msgstr "تُصدّر الشركة منتجات الألبان مثل السمن الحيواني والزبدة إلى الدول العربية مثل العراق، وتتمتع بمكانة مميزة في الأسواق المحلية والدولية."

msgid "سال تأسیس"
msgstr "سنة التأسيس"

msgid "کد اقتصادی"
msgstr "الرقم الاقتصادي"

msgid "شناسه ملی"
msgstr "الرقم الوطني"

msgid "ماموریت ما"
msgstr "رسالتنا"

msgid "۱۳۸۹"
msgstr "۱۴۳۱"

msgid "ارائه فرآورده‌های لبنی باکیفیت و استاندارد برای مصرف‌کنندگان داخلی و بین‌المللی"
msgstr "تقديم منتجات ألبان عالية الجودة وفق المعايير العالمية للمستهلكين المحليين والدوليين."

msgid "چشم‌انداز"
msgstr "رؤيتنا"

msgid "تبدیل شدن به یکی از برندهای پیشرو صادرات محصولات لبنی در منطقه"
msgstr "أن نصبح إحدى العلامات التجارية الرائدة في تصدير منتجات الألبان في المنطقة."

msgid "ارزش‌ها"
msgstr "قيمنا"

msgid "کیفیت، اصالت، اعتماد و تعهد به رضایت مشتری در تمام مراحل تولید و توزیع"
msgstr "الجودة، والأصالة، والثقة، والالتزام برضا العملاء في جميع مراحل الإنتاج والتوزيع."

msgid "ما آماده پاسخگویی به شما هستیم"
msgstr "نحن على استعداد للإجابة على استفساراتكم"

msgid "شماره تماس"
msgstr "رقم الهاتف"

msgid "آدرس کارخانه"
msgstr "عنوان المصنع"

msgid "استان گلستان، شهرستان بندرگز، بخش مرکزی، دهستان انران شرقی، آبادی شهرک صنعتی بندرگز (خیابان صنعتی بندرگز)، کوچه صنعت ۳، پلاک ۰، قطعه ۳۰، طبقه همکف"
msgstr "محافظة كلستان، قضاء بندر كز، المنطقة المركزية، ناحية أنبران الشرقية، المدينة الصناعية في بندر كز (شارع المنطقة الصناعية)، زقاق الصناعة 3، القطعة 0، القطعة رقم 30، الطابق الأرضي"

msgid "کد پستی"
msgstr "الرمز البريدي"

msgid "همکاری تجاری و سفارش عمده"
msgstr "التعاون التجاري والطلبات بالجملة"

msgid "برای سفارش‌های صادراتی و همکاری‌های تجاری با ما تماس بگیرید"
msgstr "يرجى التواصل معنا لطلبات التصدير والتعاون التجاري."

msgid "تماس مستقیم"
msgstr "اتصل مباشرة"

msgid "کیفیت ممتاز صادراتی"
msgstr "جودة تصدير ممتازة"

msgid "فرآورده‌های لبنی با استاندارد بین‌المللی"
msgstr "منتجات ألبان بمعايير دولية"

msgid "جهان نما، ارائه‌دهنده محصولات لبنی مرغوب برای بازارهای داخلی و صادراتی با تضمین کیفیت و اصالت"
msgstr "جهان نما تقدم منتجات ألبان عالية الجودة للأسواق المحلية وأسواق التصدير مع ضمان الجودة والأصالة."

msgid "مشاهده محصولات"
msgstr "عرض المنتجات"

msgid "درباره برند"
msgstr "حول العلامة التجارية"

msgid "صادراتی"
msgstr "للتصدير"

msgid "کیفیت بین‌المللی"
msgstr "جودة عالمية"

msgid "مواد اولیه مرغوب"
msgstr "مواد أولية عالية الجودة"

msgid "کیفیت تضمین‌شده"
msgstr "جودة مضمونة"

msgid "تولید با استانداردهای بهداشتی و کنترل کیفیت دقیق در تمام مراحل"
msgstr "إنتاج وفق أعلى معايير الصحة مع رقابة دقيقة على الجودة في جميع المراحل."

msgid "صادرات بین‌المللی"
msgstr "تصدير دولي"

msgid "ارسال محصولات به بازارهای عربی و کشورهای منطقه"
msgstr "توريد المنتجات إلى الأسواق العربية ودول المنطقة."

msgid "اصالت و اعتماد"
msgstr "الأصالة والثقة"

msgid "بیش از یک دهه تجربه در تولید فرآورده‌های لبنی باکیفیت"
msgstr "أكثر من عقد من الخبرة في إنتاج منتجات ألبان عالية الجودة."

msgid "مشاهده مجموعه"
msgstr "عرض المجموعة"

msgid "مجموعه"
msgstr "المجموعة"

msgid "کاوش محصولات"
msgstr "استكشف المنتجات"

msgid "در حال حاضر محصولی ثبت نشده است."
msgstr "لا توجد منتجات متاحة حالياً."

msgid "همکاری در صادرات و توزیع"
msgstr "شراكة في التصدير والتوزيع"

msgid "برای سفارش، همکاری تجاری و اطلاعات بیشتر با ما در تماس باشید"
msgstr "تواصل معنا للطلبات والشراكات التجارية ولمزيد من المعلومات."

msgid "دسترسی سریع"
msgstr "الوصول السريع"

msgid "فرآورده‌های لبنی با کیفیت صادراتی برای بازارهای بین‌المللی"
msgstr "منتجات ألبان عالية الجودة للتصدير إلى الأسواق العالمية"

msgid "ارتباط با ما"
msgstr "تواصل معنا"

msgid "گالری تصاویر"
msgstr "معرض المنتجات"

msgid "نگاهی به محصولات و فعالیت‌های ما"
msgstr "إلقاء نظرة على منتجاتنا وأنشطتنا"

msgid "تو سزاوار بهترین هستی"
msgstr "انت تستحق الافضل"

msgid "ما بهترین کیفیت را برای سفره خانواده شما و بازارهای جهانی فراهم می‌کنیم."
msgstr "نوفّر أفضل جودة لمائدة عائلتكم وللأسواق العالمية."

msgid "محصولات"
msgstr "منتجات"

msgid "فرآورده های لبنی"
msgstr "منتجات ألبان"

msgid "بدون افزودنی و نگهدارنده"
msgstr "خالية من الإضافات والمواد الحافظة"

msgid "تهیه شده از گاوهای سالم"
msgstr "مصنوعة من حليب أبقار سليمة"

msgid "تولید شده با روش سنتی و بهداشتی"
msgstr "منتجة بطرق تقليدية وصحية"

msgid "بسته‌بندی استاندارد"
msgstr "تغليف قياسي"

msgid "مشاهده محصول"
msgstr "عرض المنتج"

msgid "مجموعه ممتاز"
msgstr "مجموعة مميزة"

msgid "بازگشت به دسته‌بندی‌ها"
msgstr "العودة إلى الفئات"

msgid "ترکیب غذایی و ارزش تغذیه‌ای"
msgstr "التركيب الغذائي والقيمة الغذائية"

msgid "خواص و ارزش تغذیه‌ای روغن حیوانی"
msgstr "خصائص وقيمة السمن الغذائية"

msgid "روغن حیوانی یک فرآورده لبنی با چربی بالا است که بخش عمده آن از اسیدهای چرب تشکیل شده و در کنار انرژی، حاوی ترکیبات محلول در چربی نیز می‌باشد."
msgstr "السمن هو أحد منتجات الألبان الغنية بالدهون، ويتكون بشكل رئيسي من الأحماض الدهنية، كما يوفر الطاقة ويحتوي على بعض المركبات القابلة للذوبان في الدهون."

msgid "منبع متراکم انرژی"
msgstr "مصدر مركز للطاقة"

msgid "چربی غذایی منبعی متراکم از انرژی است و هر گرم چربی حدود ۹ کیلوکالری انرژی فراهم می‌کند."
msgstr "تُعد الدهون الغذائية مصدرًا مركزًا للطاقة، حيث يوفر كل غرام من الدهون حوالي 9 سعرات حرارية."

msgid "ویتامین‌های محلول در چربی"
msgstr "الفيتامينات القابلة للذوبان في الدهون"

msgid "روغن حیوانی می‌تواند حاوی مقادیری از ویتامین‌های محلول در چربی مانند ویتامین‌های A و E باشد؛ مقدار آن به نوع شیر و فرآوری محصول بستگی دارد."
msgstr "قد يحتوي السمن على كميات من الفيتامينات القابلة للذوبان في الدهون مثل فيتاميني A وE، وتختلف الكمية حسب نوع الحليب وطريقة معالجة المنتج."

msgid "حاوی اسیدهای چرب"
msgstr "يحتوي على الأحماض الدهنية"

msgid "این محصول حاوی ترکیبی از اسیدهای چرب اشباع و غیراشباع است و ترکیب دقیق آن به منبع شیر و شرایط تولید بستگی دارد."
msgstr "يحتوي هذا المنتج على مزيج من الأحماض الدهنية المشبعة وغير المشبعة، ويعتمد تركيبه الدقيق على مصدر الحليب وظروف الإنتاج."

msgid "فاقد آب و پروتئین قابل توجه"
msgstr "منخفض جدًا في الماء والبروتين"

msgid "در فرآیند تولید روغن حیوانی، بخش عمده آب و مواد غیرچرب جدا می‌شود و محصول نهایی عمدتاً از چربی تشکیل می‌شود."
msgstr "أثناء إنتاج السمن، تتم إزالة معظم الماء والمكونات غير الدهنية، ويصبح المنتج النهائي مكوّنًا بشكل أساسي من الدهون."

msgid "مناسب برای تأمین انرژی"
msgstr "مناسب لتوفير الطاقة"

msgid "به دلیل تراکم انرژی بالا، مصرف مقدار متعادل آن می‌تواند بخشی از انرژی مورد نیاز رژیم غذایی را تأمین کند."
msgstr "نظرًا لارتفاع كثافته من الطاقة، فإن تناوله باعتدال يمكن أن يساهم في توفير جزء من الطاقة التي يحتاجها النظام الغذائي."

msgid "بدون کربوهیدرات قابل توجه"
msgstr "لا يحتوي على كمية كبيرة من الكربوهيدرات"

msgid "روغن حیوانی عمدتاً از چربی تشکیل شده و در حالت خالص، کربوهیدرات قابل توجهی ندارد."
msgstr "يتكون السمن بشكل أساسي من الدهون، ولا يحتوي في حالته النقية على كمية كبيرة من الكربوهيدرات."

msgid "نکته تغذیه‌ای:"
msgstr "ملاحظة غذائية:"

msgid "روغن حیوانی کالری و چربی اشباع بالایی دارد؛ بنابراین مصرف متعادل آن در کنار یک رژیم غذایی متنوع توصیه می‌شود."
msgstr "السمن غني بالسعرات الحرارية والدهون المشبعة، لذلك يُنصح بتناوله باعتدال ضمن نظام غذائي متنوع ومتوازن."
